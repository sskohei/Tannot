{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tannot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tannot-db",
      "database_id": "97d7b5bd-3c01-468c-ac2d-dfa5cb342c22",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "tannot-audio"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "FREE_BOOK_LIMIT": "3"
  }
}

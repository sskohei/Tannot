{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tannot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tannot",
      "database_id": "97d7b5bd-3c01-468c-ac2d-dfa5cb342c22",
      "migrations_dir": "db/migrations"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "FREE_BOOK_LIMIT": "3"
  },
  "env": {
    "staging": {
      "name": "tannot-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tannot-staging",
          "database_id": "83eb9c6e-25f3-439a-b224-83417cf9b4e8",
          "migrations_dir": "db/migrations"
        }
      ],
      "vars": {
        "FREE_BOOK_LIMIT": "3"
      }
    }
  }
}
